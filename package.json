{
  "name": "@tradalize/core",
  "version": "0.7.2",
  "description": "Algo-trading library",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "author": "Vladyslav Bezsmertnyi",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "release": "bun run build && changeset publish",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && bun typecheck",
    "lint:fix": "eslint . --fix && bun typecheck && bun format",
    "lint:ci": "bun lint && prettier ./src --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@types/bun": "^1.2.5",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tradalize/core.git"
  },
  "bugs": {
    "url": "https://github.com/tradalize/core/issues"
  },
  "homepage": "https://github.com/tradalize/core#readme",
  "keywords": [
    "trading",
    "backtesting",
    "quant",
    "finance"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
