{
	"name": "@tradalize/core",
	"version": "0.7.2",
	"description": "Backtesting framework",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rimraf dist && tsup",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"release": "npm run build && changeset publish",
		"format": "prettier . --write",
		"lint": "eslint . --fix && npm run format",
		"lint:ci": "eslint ./src && prettier ./src --check"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tradalize/core.git"
	},
	"keywords": [
		"trading",
		"backtesting",
		"quant",
		"finance"
	],
	"author": "Vladyslav Bezsmertnyi",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/tradalize/core/issues"
	},
	"homepage": "https://github.com/tradalize/core#readme",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"axios": "^1.8.2"
	},
	"devDependencies": {
		"@changesets/cli": "^2.28.1",
		"@types/node": "^22.13.10",
		"@typescript-eslint/eslint-plugin": "^8.26.1",
		"@typescript-eslint/parser": "^8.26.1",
		"@vitest/ui": "^3.0.8",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"prettier": "^3.5.3",
		"rimraf": "^6.0.1",
		"tsup": "^8.4.0",
		"typescript": "^5.8.2",
		"vitest": "^3.0.8"
	}
}
